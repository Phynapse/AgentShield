APP_NAME=AgentShield
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true

FRONTEND_PORT=5173

EVALUATION_TIMEOUT_SECONDS=30
MAX_PAYLOAD_SIZE_KB=1024
RATE_LIMIT_PER_MINUTE=60

# SSRF protection: set to false in production
ALLOW_LOCALHOST_TARGETS=true

# Optional: semantic evaluator model (OpenAI-compatible endpoint)
EVALUATOR_MODEL_ENDPOINT=
EVALUATOR_MODEL_API_KEY=
EVALUATOR_MODEL_NAME=
